# sudo nginx -c $(pwd)/nginx.config
# sudo nginx -s quit 
http {
server {
    listen 80;
    server_name localhost;

    # 🚀 FORWARD API REQUESTS TO THE BACKEND (e.g., 8080)
    # Any request that starts with /api/ will be proxied to the backend.
    location /api/ {
        # Important: The backend only sees the path *after* /api/
        # For example, http://localhost/api/login becomes http://localhost:8080/api/login
        rewrite ^/api/(.*)$ /api/$1 break;

        proxy_pass http://localhost:8080;

        # These headers are crucial for backend authentication/session management
        proxy_set_header Host localhost:8080;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # 📱 FORWARD ALL OTHER REQUESTS TO THE FLUTTER DEV SERVER (e.g., 3000)
    # All requests that are NOT /api/ will go to your Flutter app
    location / {
        proxy_pass http://localhost:3000;
        proxy_set_header Host localhost:3000;
        

        # --- 🛠️ WebSocket FIX START ---
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # --- 🛠️ WebSocket FIX END ---
    }
}
}
events {
    worker_connections 1024; # Default is fine for local dev
}
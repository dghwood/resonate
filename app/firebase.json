{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      ".git",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "rxyz-app",
          "region": "northamerica-northeast1"
        }
      }
    ]
  }
}